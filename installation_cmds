conda activate ray-dev

export BAZEL_ARGS="--local_resources=cpu=6 \
--local_resources=memory=HOST_RAM*.35 \
--disk_cache=$HOME/bazel-cache"


set -o pipefail; \
nice -n 10 python -m pip install -e python/ --verbose 2>&1 \
  | tee ray-build.log \
  | grep --line-buffered -Ei -B 5 -A 15 \
    'error:|fatal:|failed|failure|exception|traceback|calledprocesserror|undefined reference|multiple definition|collect2:|ld:.*error|make(\[[0-9]+\])?: \*\*\*|ninja: build stopped|cmake error|build did not complete|subprocess-exited-with-error|killed|out of memory|oom|no space left|segmentation fault'
load("//bazel:ray.bzl", "ray_cc_library")

package(default_visibility = ["//visibility:public"])

ray_cc_library(
    name = "recovery_frontier_store",
    srcs = ["recovery_frontier_store.cc"],
    hdrs = ["recovery_frontier_store.h"],
    deps = [
        "//src/ray/common:id",
        "//src/ray/protobuf/frontier:recovery_frontier_cc_proto",
        "@com_google_absl//absl/container:flat_hash_map",
    ],
)

ray_cc_library(
    name = "frontier_aware_node_manager",
    srcs = ["frontier_aware_node_manager.cc"],
    hdrs = ["frontier_aware_node_manager.h"],
    deps = [
        ":recovery_frontier_store",
        "//src/ray/common:ray_config",
        "//src/ray/raylet:raylet_lib",
        "//src/ray/util:logging",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/synchronization",
    ],
)

cc_test(
    name = "recovery_frontier_store_test",
    srcs = ["recovery_frontier_store_test.cc"],
    deps = [
        ":recovery_frontier_store",
        "//src/ray/common:id",
        "//src/ray/protobuf/frontier:recovery_frontier_cc_proto",
        "@com_google_googletest//:gtest_main",
    ],
)

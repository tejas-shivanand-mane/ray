diff --git a/gossip_benchmarks/18_recovery_state_amplification.py b/gossip_benchmarks/18_recovery_state_amplification.py
new file mode 100755
--- /dev/null
+++ b/gossip_benchmarks/18_recovery_state_amplification.py
@@ -0,0 +1,637 @@
+#!/usr/bin/env python3
+"""Recovery-state amplification: Succession vs fixed witness-holder replication.
+
+Default experiment: R=4, B=1..4, and several *TaskSpec padding* sizes.
+
+The producer returns a tiny value. Size is added as many small inline task
+arguments, so the experiment grows the serialized TaskSpec rather than the
+output object. The CSV reports the actually measured TaskSpec bytes/copy.
+
+Borrowers are introduced in stages. For Succession, stage k+1 starts only
+after stage k is committed. This isolates the intended architectural
+comparison from the separate concurrent-candidate-storm problem.
+
+The current witness baseline is still eager, so B=0 is not a fair paper case.
+For B>=1, however, the full-lineage placement count measured here is the same
+count a fair lazy fixed-replication baseline would incur after activation.
+
+Outputs:
+  recovery_state_runs.csv
+  recovery_state_summary.csv
+  recovery_state_paired.csv
+  plots/lineage_byte_amplification.png
+  plots/recovery_request_messages.png
+  plots/achieved_holders.png
+"""
+from __future__ import annotations
+
+import os
+os.environ["RAY_BACKEND_LOG_LEVEL"] = "warning"
+os.environ["RAY_DEDUP_LOGS"] = "1"
+
+import argparse
+import math
+import random
+import statistics
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+import ray
+from ray._private.worker import global_worker
+from ray.cluster_utils import Cluster
+from ray.util.scheduling_strategies import NodeAffinitySchedulingStrategy
+
+from _benchmark_common import (
+    Method,
+    add_method_columns,
+    mean_ci95,
+    read_csv,
+    safe_shutdown,
+    succession,
+    system_config,
+    wait_for_cluster,
+    witness_baseline,
+    write_csv,
+)
+
+R = 4
+
+PROFILE_KEYS = [
+    "profiling_enabled",
+    "candidate_reports_received",
+    "candidate_reports_accepted",
+    "candidate_report_bytes_received",
+    "holder_install_rpcs_sent",
+    "holder_install_rpcs_completed",
+    "holder_commit_rpcs_sent",
+    "holder_commit_rpcs_completed",
+    "witness_update_rpcs_sent",
+    "witness_update_rpcs_completed",
+    "task_spec_bytes_sent",
+    "manifest_bytes_sent",
+    "full_lineage_transfer_count",
+    "holder_install_task_spec_bytes_sent",
+    "holder_install_manifest_bytes_sent",
+    "witness_update_task_spec_bytes_sent",
+    "witness_update_manifest_bytes_sent",
+    "holder_commit_manifest_bytes_sent",
+    "holder_admissions_committed",
+    "holder_admission_time_ns",
+    "witness_update_rpc_time_ns",
+]
+ASYNC_PAIRS = [
+    ("holder_install_rpcs_sent", "holder_install_rpcs_completed"),
+    ("holder_commit_rpcs_sent", "holder_commit_rpcs_completed"),
+    ("witness_update_rpcs_sent", "witness_update_rpcs_completed"),
+]
+
+
+@dataclass(frozen=True)
+class SpecSize:
+    label: str
+    padding_bytes: int
+
+
+def parse_size(text: str) -> SpecSize:
+    try:
+        label, raw = text.split(":", 1)
+        size = int(raw)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError("expected LABEL:BYTES") from exc
+    if not label or size < 0:
+        raise argparse.ArgumentTypeError("LABEL must be non-empty and BYTES >= 0")
+    return SpecSize(label, size)
+
+
+def methods() -> list[Method]:
+    return [succession(R), witness_baseline(R)]
+
+
+def profile() -> dict[str, Any]:
+    raw = global_worker.core_worker.get_recovery_succession_profile()
+    return {
+        key: raw.get(key, False if key == "profiling_enabled" else 0)
+        for key in PROFILE_KEYS
+    }
+
+
+def outstanding(p: dict[str, Any]) -> int:
+    return sum(
+        max(0, int(p[a]) - int(p[b]))
+        for a, b in ASYNC_PAIRS
+    )
+
+
+def wait_quiescent(timeout_s: float, stable_s: float) -> tuple[dict[str, Any], bool]:
+    deadline = time.monotonic() + timeout_s
+    last_sig = None
+    stable_since = None
+    last = profile()
+
+    while time.monotonic() < deadline:
+        last = profile()
+        sig = tuple(last[k] for k in PROFILE_KEYS)
+        now = time.monotonic()
+
+        if outstanding(last) == 0:
+            if sig == last_sig:
+                if stable_since is None:
+                    stable_since = now
+                elif now - stable_since >= stable_s:
+                    return last, True
+            else:
+                stable_since = now
+        else:
+            stable_since = None
+
+        last_sig = sig
+        time.sleep(0.05)
+
+    return last, False
+
+
+def wait_admissions(expected: int, timeout_s: float) -> None:
+    deadline = time.monotonic() + timeout_s
+    got = 0
+    while time.monotonic() < deadline:
+        got = int(profile()["holder_admissions_committed"])
+        if got >= expected:
+            return
+        time.sleep(0.02)
+    raise TimeoutError(f"holder admissions: expected >= {expected}, got {got}")
+
+
+def start_cluster(method: Method, cpus: int, witness_count: int) -> tuple[Cluster, str]:
+    cluster = Cluster()
+    # Driver/head is the producer-task owner. R other independent nodes must
+    # be available for the fixed baseline.
+    cluster.add_node(
+        num_cpus=0,
+        _system_config=system_config(
+            method,
+            witness_count=witness_count,
+            profiling_enabled=True,
+        ),
+        include_dashboard=False,
+    )
+    producer = cluster.add_node(
+        num_cpus=cpus,
+        resources={"producer_node": 1},
+    )
+    for i in range(1, R + 1):
+        cluster.add_node(
+            num_cpus=cpus,
+            resources={f"borrower_{i}": 1},
+        )
+    return cluster, producer.node_id
+
+
+def remote_types():
+    @ray.remote(max_retries=2)
+    def produce(request_id: int, *padding: bytes) -> int:
+        # Padding grows TaskSpec; the return stays tiny.
+        if padding and padding[0]:
+            _ = padding[0][0]
+        return request_id
+
+    @ray.remote(max_restarts=0, max_concurrency=128)
+    class Borrower:
+        def touch(self, wrapped_ref):
+            ref = wrapped_ref[0]
+            return int(ray.get(ref))
+
+        def ping(self):
+            import os
+            return os.getpid()
+
+    return produce, Borrower
+
+
+def padding_chunks(total: int, chunk_size: int) -> tuple[bytes, ...]:
+    chunks = []
+    left = total
+    token = 1
+    while left > 0:
+        n = min(left, chunk_size)
+        chunks.append(bytes([token % 251]) * n)
+        token += 1
+        left -= n
+    return tuple(chunks)
+
+
+def safe_avg(total: Any, count: Any) -> float:
+    n = int(count)
+    return float(total) / n if n else math.nan
+
+
+def run_one(
+    args: argparse.Namespace,
+    method: Method,
+    spec: SpecSize,
+    borrowers: int,
+    repetition: int,
+) -> dict[str, Any]:
+    cluster = None
+    try:
+        cluster, producer_node = start_cluster(
+            method, args.cpus_per_node, args.witness_count
+        )
+        ray.init(address=cluster.address, log_to_driver=False, include_dashboard=False)
+        wait_for_cluster(ray, R + 2, args.cluster_timeout_seconds)
+
+        produce, Borrower = remote_types()
+        borrower_actors = [
+            Borrower.options(
+                resources={f"borrower_{i}": 0.01},
+                num_cpus=0,
+            ).remote()
+            for i in range(1, R + 1)
+        ]
+        ray.get([a.ping.remote() for a in borrower_actors])
+
+        padding = padding_chunks(spec.padding_bytes, args.inline_chunk_bytes)
+        global_worker.core_worker.reset_recovery_succession_profile()
+
+        start_ns = time.perf_counter_ns()
+        refs = [
+            produce.options(
+                scheduling_strategy=NodeAffinitySchedulingStrategy(
+                    node_id=producer_node, soft=False
+                ),
+                num_cpus=1,
+            ).remote(i, *padding)
+            for i in range(args.task_count)
+        ]
+        ray.get(refs)
+
+        # Direct-owner, staged fan-out. The driver keeps refs alive throughout.
+        for stage in range(borrowers):
+            ray.get([
+                borrower_actors[stage].touch.remote([ref])
+                for ref in refs
+            ])
+            if not method.baseline_enabled:
+                wait_admissions(
+                    args.task_count * (stage + 1),
+                    args.admission_timeout_seconds,
+                )
+
+        p, quiescent = wait_quiescent(
+            args.profile_quiescence_timeout_seconds,
+            args.profile_stable_seconds,
+        )
+        elapsed_s = (time.perf_counter_ns() - start_ns) / 1e9
+
+        n = args.task_count
+        lineage_copies = int(p["full_lineage_transfer_count"])
+        lineage_bytes = int(p["task_spec_bytes_sent"])
+        manifest_bytes = int(p["manifest_bytes_sent"])
+        candidate_bytes = int(p["candidate_report_bytes_received"])
+
+        messages = (
+            int(p["candidate_reports_received"])
+            + int(p["holder_install_rpcs_sent"])
+            + int(p["witness_update_rpcs_sent"])
+            + int(p["holder_commit_rpcs_sent"])
+        )
+        request_payload_bytes = lineage_bytes + manifest_bytes + candidate_bytes
+
+        expected_copies = n * (R if method.baseline_enabled else min(borrowers, R))
+        achieved_holders = (
+            lineage_copies / n
+            if method.baseline_enabled
+            else int(p["holder_admissions_committed"]) / n
+        )
+
+        row = {
+            "repetition": repetition,
+            "target_holders": R,
+            "borrower_count": borrowers,
+            "task_count": n,
+            "task_spec_size_label": spec.label,
+            "task_spec_padding_bytes": spec.padding_bytes,
+            "profile_quiescent": int(quiescent),
+            "profile_async_outstanding": outstanding(p),
+            "expected_full_lineage_transfers": expected_copies,
+            "full_lineage_transfer_count": lineage_copies,
+            "full_lineage_transfer_count_ok": int(lineage_copies == expected_copies),
+            "full_lineage_copies_per_task": lineage_copies / n,
+            "achieved_holders_per_task": achieved_holders,
+            "full_lineage_bytes_total": lineage_bytes,
+            "full_lineage_bytes_per_task": lineage_bytes / n,
+            "measured_task_spec_bytes_per_copy": safe_avg(lineage_bytes, lineage_copies),
+            "holder_lineage_bytes_total": int(
+                p["holder_install_task_spec_bytes_sent"]
+            ),
+            "witness_lineage_bytes_total": int(
+                p["witness_update_task_spec_bytes_sent"]
+            ),
+            "compact_witness_manifest_bytes_total": int(
+                p["witness_update_manifest_bytes_sent"]
+            ),
+            "candidate_reports_total": int(p["candidate_reports_received"]),
+            "candidate_report_bytes_total": candidate_bytes,
+            "holder_install_rpcs_total": int(p["holder_install_rpcs_sent"]),
+            "witness_update_rpcs_total": int(p["witness_update_rpcs_sent"]),
+            "recovery_request_messages_total": messages,
+            "recovery_request_messages_per_task": messages / n,
+            # Protobuf request payload only: excludes gRPC framing/replies.
+            "recovery_request_payload_bytes_total": request_payload_bytes,
+            "recovery_request_payload_bytes_per_task": request_payload_bytes / n,
+            "manifest_bytes_per_task": manifest_bytes / n,
+            "elapsed_seconds": elapsed_s,
+            "activated_tasks_per_second": n / elapsed_s,
+        }
+        for key in PROFILE_KEYS:
+            row[f"profile_{key}"] = p[key]
+
+        print(
+            "  "
+            f"copies/task={row['full_lineage_copies_per_task']:.2f} "
+            f"lineage_KiB/task={row['full_lineage_bytes_per_task']/1024:.1f} "
+            f"msgs/task={row['recovery_request_messages_per_task']:.2f} "
+            f"control_KiB/task={row['recovery_request_payload_bytes_per_task']/1024:.1f} "
+            f"achieved={row['achieved_holders_per_task']:.2f} "
+            f"valid={row['full_lineage_transfer_count_ok']}"
+        )
+        return add_method_columns(row, method)
+    finally:
+        safe_shutdown(ray, cluster)
+
+
+METRICS = [
+    "full_lineage_copies_per_task",
+    "achieved_holders_per_task",
+    "full_lineage_bytes_per_task",
+    "measured_task_spec_bytes_per_copy",
+    "recovery_request_messages_per_task",
+    "recovery_request_payload_bytes_per_task",
+    "manifest_bytes_per_task",
+    "activated_tasks_per_second",
+    "elapsed_seconds",
+]
+
+
+def summarize(rows: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    out = []
+    keys = sorted({
+        (
+            r["method"], r["method_label"], int(r["borrower_count"]),
+            r["task_spec_size_label"], int(r["task_spec_padding_bytes"]),
+        )
+        for r in rows
+    }, key=lambda x: (x[4], x[2], x[0]))
+
+    for method, label, b, size_label, padding in keys:
+        matched = [
+            r for r in rows
+            if r["method"] == method
+            and int(r["borrower_count"]) == b
+            and r["task_spec_size_label"] == size_label
+        ]
+        s = {
+            "method": method,
+            "method_label": label,
+            "borrower_count": b,
+            "target_holders": R,
+            "task_spec_size_label": size_label,
+            "task_spec_padding_bytes": padding,
+            "repetitions": len(matched),
+            "all_runs_valid": int(all(
+                int(r["profile_quiescent"]) == 1
+                and int(r["full_lineage_transfer_count_ok"]) == 1
+                for r in matched
+            )),
+        }
+        for metric in METRICS:
+            mean, ci = mean_ci95(float(r[metric]) for r in matched)
+            s[f"{metric}_mean"] = mean
+            s[f"{metric}_ci95"] = ci
+        out.append(s)
+    return out
+
+
+def paired(summary: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    out = []
+    cases = sorted({
+        (
+            int(r["borrower_count"]),
+            r["task_spec_size_label"],
+            int(r["task_spec_padding_bytes"]),
+        )
+        for r in summary
+    }, key=lambda x: (x[2], x[0]))
+
+    for b, label, padding in cases:
+        suc = next(
+            r for r in summary
+            if r["method"] == "succession"
+            and int(r["borrower_count"]) == b
+            and r["task_spec_size_label"] == label
+        )
+        base = next(
+            r for r in summary
+            if r["method"] == "witness_baseline"
+            and int(r["borrower_count"]) == b
+            and r["task_spec_size_label"] == label
+        )
+        sb = float(suc["full_lineage_bytes_per_task_mean"])
+        bb = float(base["full_lineage_bytes_per_task_mean"])
+        sc = float(suc["recovery_request_payload_bytes_per_task_mean"])
+        bc = float(base["recovery_request_payload_bytes_per_task_mean"])
+        out.append({
+            "borrower_count": b,
+            "target_holders": R,
+            "task_spec_size_label": label,
+            "task_spec_padding_bytes": padding,
+            "expected_lineage_amplification": R / max(1, min(b, R)),
+            "measured_lineage_amplification_baseline_over_succession": bb / sb if sb else math.nan,
+            "measured_control_payload_amplification_baseline_over_succession": bc / sc if sc else math.nan,
+            "succession_achieved_holders_per_task": suc["achieved_holders_per_task_mean"],
+            "baseline_achieved_holders_per_task": base["achieved_holders_per_task_mean"],
+            "succession_request_messages_per_task": suc["recovery_request_messages_per_task_mean"],
+            "baseline_request_messages_per_task": base["recovery_request_messages_per_task_mean"],
+            "succession_lineage_bytes_per_task": sb,
+            "baseline_lineage_bytes_per_task": bb,
+            "succession_activated_tasks_per_second": suc["activated_tasks_per_second_mean"],
+            "baseline_activated_tasks_per_second": base["activated_tasks_per_second_mean"],
+        })
+    return out
+
+
+def run(args: argparse.Namespace) -> None:
+    if 0 in args.borrowers:
+        print("WARNING: B=0 is not fair until WitnessBaseline is made lazy.")
+    if any(b < 0 or b > R for b in args.borrowers):
+        raise ValueError(f"--borrowers must be in [0,{R}]")
+
+    cases = [
+        (m, size, b)
+        for size in args.task_spec_sizes
+        for b in args.borrowers
+        for m in methods()
+    ]
+    rng = random.Random(args.seed)
+    rows = []
+
+    for rep in range(1, args.repetitions + 1):
+        order = cases[:]
+        if not args.fixed_order:
+            rng.shuffle(order)
+        for method, size, b in order:
+            print(
+                f"rep={rep} method={method.label} B={b} "
+                f"padding={size.label} tasks={args.task_count}"
+            )
+            rows.append(run_one(args, method, size, b, rep))
+
+    root = Path(args.output_dir)
+    write_csv(root / "recovery_state_runs.csv", rows)
+    summary = summarize(rows)
+    write_csv(root / "recovery_state_summary.csv", summary)
+    write_csv(root / "recovery_state_paired.csv", paired(summary))
+
+
+def plot(args: argparse.Namespace) -> None:
+    import matplotlib.pyplot as plt
+
+    root = Path(args.output_dir)
+    pair_rows = read_csv(root / "recovery_state_paired.csv")
+    summary = read_csv(root / "recovery_state_summary.csv")
+    plots = root / "plots"
+    plots.mkdir(parents=True, exist_ok=True)
+
+    # Key plot: baseline full-lineage bytes / Succession full-lineage bytes.
+    plt.figure(figsize=(8, 5))
+    sizes = sorted({
+        (int(r["task_spec_padding_bytes"]), r["task_spec_size_label"])
+        for r in pair_rows
+    })
+    for _, label in sizes:
+        rows = sorted(
+            [r for r in pair_rows if r["task_spec_size_label"] == label],
+            key=lambda r: int(r["borrower_count"]),
+        )
+        plt.plot(
+            [int(r["borrower_count"]) for r in rows],
+            [float(r["measured_lineage_amplification_baseline_over_succession"]) for r in rows],
+            marker="o", label=label,
+        )
+    bs = sorted({int(r["borrower_count"]) for r in pair_rows})
+    if bs:
+        plt.plot(
+            bs, [R / max(1, min(b, R)) for b in bs],
+            marker="x", linestyle="--", label="Ideal R/min(B,R)",
+        )
+    plt.xlabel("Downstream borrowers B")
+    plt.ylabel("Baseline / Succession full-lineage bytes")
+    plt.xticks(bs)
+    plt.legend()
+    plt.tight_layout()
+    plt.savefig(plots / "lineage_byte_amplification.png", dpi=200)
+    plt.close()
+
+    # Recovery-control message count; average the TaskSpec size cases.
+    plt.figure(figsize=(8, 5))
+    for method, label in [
+        ("succession", "Succession-R4"),
+        ("witness_baseline", "WitnessBaseline-R4"),
+    ]:
+        xs, ys = [], []
+        for b in bs:
+            vals = [
+                float(r["recovery_request_messages_per_task_mean"])
+                for r in summary
+                if r["method"] == method and int(r["borrower_count"]) == b
+            ]
+            if vals:
+                xs.append(b)
+                ys.append(statistics.fmean(vals))
+        plt.plot(xs, ys, marker="o", label=label)
+    plt.xlabel("Downstream borrowers B")
+    plt.ylabel("Recovery-control request messages / task")
+    plt.xticks(bs)
+    plt.legend()
+    plt.tight_layout()
+    plt.savefig(plots / "recovery_request_messages.png", dpi=200)
+    plt.close()
+
+    # State savings must be paired with the protection actually achieved.
+    plt.figure(figsize=(8, 5))
+    for method, label in [
+        ("succession", "Succession-R4"),
+        ("witness_baseline", "WitnessBaseline-R4"),
+    ]:
+        xs, ys = [], []
+        for b in bs:
+            vals = [
+                float(r["achieved_holders_per_task_mean"])
+                for r in summary
+                if r["method"] == method and int(r["borrower_count"]) == b
+            ]
+            if vals:
+                xs.append(b)
+                ys.append(statistics.fmean(vals))
+        plt.plot(xs, ys, marker="o", label=label)
+    plt.xlabel("Downstream borrowers B")
+    plt.ylabel("Achieved non-owner full-lineage holders / task")
+    plt.xticks(bs)
+    plt.ylim(bottom=0)
+    plt.legend()
+    plt.tight_layout()
+    plt.savefig(plots / "achieved_holders.png", dpi=200)
+    plt.close()
+
+
+def parser() -> argparse.ArgumentParser:
+    p = argparse.ArgumentParser()
+    p.add_argument(
+        "command", choices=["run", "plot", "run-and-plot"],
+        nargs="?", default="run-and-plot",
+    )
+    p.add_argument(
+        "--output-dir",
+        default="gossip_benchmarks/results/18_recovery_state_amplification",
+    )
+    p.add_argument("--task-count", type=int, default=50)
+    p.add_argument("--borrowers", type=int, nargs="+", default=[1, 2, 3, 4])
+    p.add_argument(
+        "--task-spec-sizes", type=parse_size, nargs="+",
+        default=[
+            SpecSize("1KiB", 1024),
+            SpecSize("16KiB", 16 * 1024),
+            SpecSize("256KiB", 256 * 1024),
+            SpecSize("1MiB", 1024 * 1024),
+        ],
+        help="LABEL:INLINE_PADDING_BYTES; actual TaskSpec bytes/copy are measured.",
+    )
+    p.add_argument(
+        "--inline-chunk-bytes", type=int, default=4096,
+        help="Keep each padding argument small enough to remain inline.",
+    )
+    p.add_argument("--repetitions", type=int, default=1)
+    p.add_argument("--cpus-per-node", type=int, default=2)
+    p.add_argument("--witness-count", type=int, default=2)
+    p.add_argument("--cluster-timeout-seconds", type=float, default=30)
+    p.add_argument("--admission-timeout-seconds", type=float, default=60)
+    p.add_argument("--profile-quiescence-timeout-seconds", type=float, default=30)
+    p.add_argument("--profile-stable-seconds", type=float, default=0.5)
+    p.add_argument("--seed", type=int, default=42)
+    p.add_argument("--fixed-order", action="store_true")
+    return p
+
+
+def main() -> None:
+    args = parser().parse_args()
+    if args.task_count <= 0 or args.inline_chunk_bytes <= 0:
+        raise ValueError("task-count and inline-chunk-bytes must be positive")
+    if args.command in {"run", "run-and-plot"}:
+        run(args)
+    if args.command in {"plot", "run-and-plot"}:
+        plot(args)
+
+
+if __name__ == "__main__":
+    main()
